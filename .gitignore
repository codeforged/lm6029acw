# ============================================================
# lm6029acw — .gitignore
# native addon: yang di-commit HANYA sumber, bukan hasil build.
# ============================================================

# --- Dependensi ---
node_modules/

# --- Artefak node-gyp (dibuat ulang oleh `npm install`) ---
build/
*.node
*.o
*.obj

# --- Hasil `npm pack` / publish (jangan sampai ikut ter-commit) ---
*.tgz

# --- Log & file OS ---
*.log
npm-debug.log*
.DS_Store
Thumbs.db
